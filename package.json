{
  "name": "oracle-travis-pipeline",
  "private": true,
  "type": "module",
  "workspaces": ["packages/*", "apps/*", "infra"],
  "engines": { "node": ">=22" },
  "scripts": {
    "build": "turbo run build",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "lint": "eslint .",
    "format": "prettier --write .",
    "pipeline": "npm run cli -w @oracle/pipeline --",
    "mcp": "npm run start:http -w @oracle/mcp"
  },
  "devDependencies": {
    "@eslint/js": "^9.37.0",
    "@types/node": "^24.0.0",
    "eslint": "^9.37.0",
    "prettier": "^3.6.2",
    "tsx": "^4.20.6",
    "turbo": "^2.5.8",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.46.0",
    "vitest": "^3.2.4"
  },
  "packageManager": "npm@11.12.1"
}
