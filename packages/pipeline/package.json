{
  "name": "@oracle/pipeline",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "bin": {
    "oracle-pipeline": "dist/cli/main.js",
    "oracle-pipeline-runner": "dist/cli/runner.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "cli": "tsx --env-file-if-exists=../../.env src/cli/main.ts",
    "runner": "tsx --env-file-if-exists=../../.env src/cli/runner.ts"
  },
  "dependencies": {
    "@duckdb/node-api": "1.5.6-r.1",
    "@ipld/car": "^5.4.7",
    "@ipld/dag-pb": "^4.1.5",
    "blockstore-core": "^5.0.4",
    "ipfs-unixfs-importer": "^17.1.1",
    "multiformats": "^14.0.5",
    "zod": "^4.6.7",
    "@aws-sdk/client-s3": "^3.1152.0",
    "@aws-sdk/client-ssm": "^3.1152.0",
    "@aws-sdk/lib-storage": "^3.1152.0"
  }
}
